{
  "name": "cockpit",
  "private": true,
  "packageManager": "pnpm@10.7.1",
  "scripts": {
    "build": "tsc -b",
    "clean": "find . -name '*.tsbuildinfo' -delete && find packages -name dist -type d -prune -exec rm -rf {} +",
    "dev": "pnpm --filter @cockpit-ai/cli dev",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
