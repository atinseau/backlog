{
  "name": "backlog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:ui": "bun run --cwd packages/board-ui build",
    "dev": "bun run packages/cli/src/bin.ts",
    "dev:ui": "bun run --cwd packages/board-ui dev",
    "test": "bun test ./packages",
    "typecheck": "tsc --noEmit && bun run --cwd packages/board-ui typecheck",
    "clean": "rm -rf dist packages/board-ui/dist packages/server/src/ui-assets.generated.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.8.3"
  }
}
