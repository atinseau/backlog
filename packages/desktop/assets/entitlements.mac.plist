<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- V8 + Electron's JS engine need executable JIT pages. Without
       this, the renderer process crashes on launch under hardened
       runtime. Required for ALL Electron apps. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Backlog spawns claude / codex / custom-command CLIs and runs
       git worktree / commit / push. Hardened runtime requires this
       entitlement to allow loading those external libraries. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- The embedded Hono server binds to 127.0.0.1 and the renderer
       talks to it. We're a client, but the server side is bound
       inside our own process so it's still a network connection
       that needs to be allowed. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>

  <!-- File access — the user picks any folder on their disk as a
       project root, and the agent CLIs read/write inside it. The
       desktop app inherits the user's filesystem privileges; sandbox
       is OFF (we are a developer tool, not a Mac App Store app). -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <key>com.apple.security.files.bookmarks.app-scope</key>
  <true/>

  <!-- Apple Events — agents may shell out to interact with Finder /
       Terminal / VS Code (e.g. "open in Finder" IPC). Keeps that
       capability available. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
